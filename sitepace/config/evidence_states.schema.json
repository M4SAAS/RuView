{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SitePace RF Evidence State",
  "type": "object",
  "required": ["event_id", "event_state", "identity_state", "timestamp_start", "timestamp_end"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_state": {"enum": ["UNKNOWN", "CANDIDATE", "SUPPORTED", "VERIFIED"]},
    "identity_state": {"enum": ["UNKNOWN", "ANONYMOUS_TRACKED", "PROBABLE", "CONFIRMED", "AMBIGUOUS", "LOST_REBIND_REQUIRED"]},
    "worker_uid": {"type": ["string", "null"]},
    "credential_uid": {"type": ["string", "null"]},
    "ruview_person_id": {"type": ["string", "null"]},
    "track_id": {"type": ["string", "null"]},
    "zone_id": {"type": ["string", "null"]},
    "timestamp_start": {"type": "string", "format": "date-time"},
    "timestamp_end": {"type": "string", "format": "date-time"},
    "behavior_label": {"type": ["string", "null"]},
    "behavior_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "identity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "abstention_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"identity_state": {"const": "CONFIRMED"}}},
      "then": {"required": ["worker_uid", "credential_uid"]}
    },
    {
      "if": {"properties": {"event_state": {"const": "VERIFIED"}}},
      "then": {"minProperties": 6}
    }
  ]
}